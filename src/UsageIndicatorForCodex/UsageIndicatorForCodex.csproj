<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>UsageIndicatorForCodex.Gui</AssemblyName>
    <RootNamespace>UsageIndicatorForCodex</RootNamespace>
    <Product>Usage Indicator for Codex</Product>
    <Description>Displays Codex CLI account usage over the Codex Desktop title bar.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(RepositoryUrl)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UsageIndicatorRepositoryUrl</_Parameter1>
      <_Parameter2>$(RepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE"
          Link="LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
